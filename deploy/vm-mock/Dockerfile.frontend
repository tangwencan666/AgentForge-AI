FROM node:24-alpine@sha256:ebfe2f90462722a7a4de65e91990e97fe0d401c70e0e762c5b53302f905ec1c1 AS build
WORKDIR /src
COPY frontend/package*.json ./
RUN npm ci
COPY frontend/ ./
RUN npm run build
FROM nginxinc/nginx-unprivileged:stable-alpine@sha256:56b8272e43a0525f67aed68d1e0794a712d10e3e45a563e118e9a77c817e6f86
ARG BUILD_REVISION
LABEL org.opencontainers.image.source="https://github.com/tangwencan666/AgentForge-AI" \
      org.opencontainers.image.revision="${BUILD_REVISION}" \
      ai.agentforge.demo="vm-mock"
COPY frontend/deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /src/dist /usr/share/nginx/html
# The base image already provides an unprivileged nginx runtime. Skip its
# mutable configuration entrypoint; the committed config has no templates.
ENTRYPOINT ["nginx"]
CMD ["-g", "daemon off;"]
