# Generate .env with scripts/bootstrap_local.py. No real API Key is needed in P1.
COMPOSE_PROJECT_NAME=agentforge-p1
POSTGRES_PORT=15432
REDIS_PORT=16379
BACKEND_PORT=18100
FRONTEND_PORT=15173
POSTGRES_PASSWORD=GENERATE_LOCAL_RANDOM_VALUE
APP_DB_PASSWORD=GENERATE_SEPARATE_LOCAL_RANDOM_VALUE
REDIS_PASSWORD=GENERATE_LOCAL_RANDOM_VALUE
AGENTFORGE_ENVIRONMENT=development
AGENTFORGE_DATABASE_URL=postgresql+asyncpg://agentforge:GENERATED@127.0.0.1:15432/agentforge
AGENTFORGE_REDIS_URL=redis://:GENERATED@127.0.0.1:16379/0
AGENTFORGE_ADMIN_TOKEN=GENERATE_AT_LEAST_32_CHARACTERS
AGENTFORGE_TENANT_ID=00000000-0000-4000-8000-000000000001
AGENTFORGE_ALLOWED_MODEL_HOSTS=api.openai.com,api.anthropic.com,generativelanguage.googleapis.com
