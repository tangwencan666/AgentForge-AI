# Generate .env with scripts/bootstrap_local.py. No real API Key is needed in P1.
COMPOSE_PROJECT_NAME=agentforge-p1
POSTGRES_PORT=15432
REDIS_PORT=16379
BACKEND_PORT=18100
FRONTEND_PORT=15173
POSTGRES_PASSWORD=GENERATE_LOCAL_RANDOM_VALUE
APP_DB_PASSWORD=GENERATE_SEPARATE_LOCAL_RANDOM_VALUE
REDIS_PASSWORD=GENERATE_LOCAL_RANDOM_VALUE
AGENTFORGE_ENVIRONMENT=development
AGENTFORGE_DATABASE_URL=postgresql+asyncpg://agentforge:GENERATED@127.0.0.1:15432/agentforge
AGENTFORGE_REDIS_URL=redis://:GENERATED@127.0.0.1:16379/0
AGENTFORGE_ADMIN_TOKEN=GENERATE_AT_LEAST_32_CHARACTERS
AGENTFORGE_TENANT_ID=00000000-0000-4000-8000-000000000001
AGENTFORGE_ALLOWED_MODEL_HOSTS=api.openai.com,api.anthropic.com,generativelanguage.googleapis.com
# P3: bootstrap-sandbox.py registers a reviewed immutable image and distinct project role tokens.
SANDBOX_RUNNER_PORT=18120
# AGENTFORGE_SANDBOX_IMAGE_ID=sha256:REVIEWED_IMAGE_ID
# AGENTFORGE_SANDBOX_RUNNER_TOKEN=GENERATE_DISTINCT_LOCAL_RANDOM_VALUE
# AGENTFORGE_SANDBOX_APPROVER_TOKEN=GENERATE_DISTINCT_LOCAL_RANDOM_VALUE
# P4: scripts/bootstrap-p4.py creates distinct credentials in the ignored .env.
# AGENTFORGE_MCP_SERVER_TOKEN=GENERATE_DISTINCT_LOCAL_RANDOM_VALUE
# AGENTFORGE_CAPABILITY_APPROVER_TOKEN=GENERATE_DISTINCT_LOCAL_RANDOM_VALUE
AGENTFORGE_MCP_DAILY_CALL_LIMIT=1000
AGENTFORGE_MCP_TIMEOUT_SECONDS=8
# P5: keep disabled until a local operator approves credentials, endpoints, prices and spending limits.
AGENTFORGE_REAL_CALLS_ENABLED=false
AGENTFORGE_REAL_DAILY_BUDGET_USD=0
AGENTFORGE_REAL_DAILY_TOKEN_LIMIT=100000
AGENTFORGE_REAL_TEST_BUDGET_USD=0
AGENTFORGE_REAL_TEST_MAX_CALLS=1
AGENTFORGE_MODEL_PRICES={}
AGENTFORGE_MODEL_CREDENTIAL_HOSTS={}
# Set actual keys only in the protected local environment; never paste them in chat or commit them.
# AGENTFORGE_MODEL_PLANNER_KEY=SET_LOCALLY_ONLY
# AGENTFORGE_MODEL_CODER_KEY=SET_LOCALLY_ONLY
# AGENTFORGE_MODEL_RESEARCHER_KEY=SET_LOCALLY_ONLY
# AGENTFORGE_MODEL_REVIEWER_KEY=SET_LOCALLY_ONLY
